    {
      "name": "02. Search & Security Filter",
      "description": "Các kịch bản tìm kiếm, trích xuất dữ liệu động (Data Chaining) và kiểm thử an toàn bảo mật (XSS, SQLi)",
      "item": [
        {
          "name": "MOV_TC05 - Tìm kiếm từ khóa chính xác & Trích xuất Movie ID (/search.php?q=Doraemon)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Search result returns matching keyword\", function () {",
                  "    const html = pm.response.text();",
                  "    pm.expect(html.toLowerCase()).to.include(\"doraemon\");",
                  "});",
                  "",
                  "// Dynamic Data Chaining: Trích xuất ID phim từ kết quả tìm kiếm",
                  "const html = pm.response.text();",
                  "const match = html.match(/watch\\.php\\?id=(\\d+)/);",
                  "if (match && match[1]) {",
                  "    pm.collectionVariables.set(\"activeMovieId\", match[1]);",
                  "    console.log(\"[Data Chain] Đã lưu activeMovieId mới: \" + match[1]);",
                  "} else {",
                  "    console.log(\"[Data Chain] Giữ nguyên activeMovieId mặc định: \" + pm.collectionVariables.get(\"activeMovieId\"));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/search.php?query={{searchKeyword}}",
              "host": ["{{baseUrl}}"],
              "path": ["search.php"],
              "query": [
                {
                  "key": "query",
                  "value": "{{searchKeyword}}"
                }
              ]
            }
          }
        },
        {
          "name": "MOV_TC06 - Tìm kiếm không phân biệt chữ hoa thường (/search.php?q=POKEMON)",
          "event": [
            {
