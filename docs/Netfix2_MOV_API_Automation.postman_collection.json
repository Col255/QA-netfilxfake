        },
        {
          "name": "MOV_TC08 - Kiểm tra phòng chống Reflected XSS (/search.php?query=<script>alert('XSS')</script>)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Reflected input is properly sanitized or encoded (No raw <script> tag)\", function () {",
                  "    const html = pm.response.text();",
                  "    // Khẳng định không xuất hiện thẻ thực thi script thô trong HTML",
                  "    pm.expect(html).to.not.include(\"<script>alert('XSS')</script>\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/search.php?query=<script>alert('XSS')</script>",
              "host": ["{{baseUrl}}"],
              "path": ["search.php"],
              "query": [
                {
                  "key": "query",
                  "value": "<script>alert('XSS')</script>"
                }
              ]
            }
          }
        },
        {
          "name": "MOV_TC09 - Kiểm tra an toàn SQL Injection (/search.php?query=Doraemon' OR '1'='1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"No SQL syntax error or exception dumped\", function () {",
                  "    const html = pm.response.text();",
                  "    pm.expect(html).to.not.include(\"syntax error\");",
                  "    pm.expect(html).to.not.include(\"mysqli_query\");",
                  "    pm.expect(html).to.not.include(\"Warning\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/search.php?query=Doraemon' OR '1'='1",
              "host": ["{{baseUrl}}"],
              "path": ["search.php"],
              "query": [
                {
                  "key": "query",
                  "value": "Doraemon' OR '1'='1"
                }
              ]
            }
          }
        }
      ]
