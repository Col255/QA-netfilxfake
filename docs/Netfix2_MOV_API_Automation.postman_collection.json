  "item": [
    {
      "name": "01. Discovery & Catalog [KAN-23]",
      "description": "[KAN-23] Các kịch bản kiểm thử tự động trang chủ khám phá, hiển thị slider phim nổi bật và lọc danh mục phim (/index.php, /movies.php)",
      "item": [
        {
          "name": "KAN-23-TC01: MOV_TC01 - Khám phá trang chủ (/index.php)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"[KAN-23] Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"[KAN-23] Response time SLA is below 1500ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1500);",
                  "});",
                  "",
                  "pm.test(\"[KAN-23] Content-Type contains text/html\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/html\");",
                  "});",
                  "",
                  "pm.test(\"[KAN-23] Homepage contains Top Movies Slider and Main Navigation\", function () {",
                  "    const html = pm.response.text();",
                  "    pm.expect(html).to.include(\"top-movies-slide\");",
                  "    pm.expect(html).to.include(\"NetfixVN\");",
                  "});",
                  "",
                  "pm.test(\"[KAN-23] Response does not leak PHP Errors or Warnings\", function () {",
                  "    const html = pm.response.text();",
                  "    pm.expect(html).to.not.include(\"Fatal error\");",
                  "    pm.expect(html).to.not.include(\"Warning: mysqli\");",
                  "    pm.expect(html).to.not.include(\"Notice:\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/html,application/xhtml+xml,application/xml"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/index.php",
              "host": ["{{baseUrl}}"],
              "path": ["index.php"]
            }
          }
        },
