    {
      "name": "04. Interactions & Metrics API",
      "description": "Kiểm thử API JSON ghi nhận bộ đếm lượt xem (View Counter) và xác thực Contract",
      "item": [
        {
          "name": "MOV_TC16 - Tăng lượt xem phim thành công (/api/view_counter.php?id={{activeMovieId}})",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time SLA is below 500ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "",
                  "pm.test(\"Content-Type is application/json\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"Response contract matches specification\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.be.an(\"object\");",
                  "    pm.expect(data).to.have.property(\"success\");",
                  "    pm.expect(data.success).to.be.true;",
                  "    pm.expect(data).to.have.property(\"movie_id\");",
                  "    ",
                  "    const expectedId = parseInt(pm.collectionVariables.get(\"activeMovieId\") || 52);",
                  "    pm.expect(data.movie_id).to.eql(expectedId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/view_counter.php?id={{activeMovieId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "view_counter.php"],
              "query": [
                {
                  "key": "id",
                  "value": "{{activeMovieId}}"
                }
              ]
            }
          }
        },
