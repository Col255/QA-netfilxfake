{
  "info": {
    "_postman_id": "mov-netfix2-qa-automation-2026",
    "name": "Netfix2 - Movie & Discovery (MOV) API Automation",
    "description": "Bộ Automation Test API & Chức năng cho nhóm Movie & Discovery (MOV) trên hệ thống Netfix2 Streaming Platform. Bao gồm kiểm thử Happy Path, Negative Testing, Edge Cases, Security (XSS/SQLi), Data Chaining và JSON Contract Verification.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
